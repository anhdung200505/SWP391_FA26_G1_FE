// AnhDuySport — dán vào https://dbdiagram.io
// Xóa hết nội dung cũ trong khung trái, rồi dán file này.

Table role {
  role_id int [pk, increment]
  role_code nvarchar [not null, unique]
  role_name nvarchar [not null]
  description nvarchar
}

Table role_permission {
  role_permission_id int [pk, increment]
  role_id int [not null, ref: > role.role_id]
  permission_code nvarchar [not null]
  permission_name nvarchar [not null]

  Indexes {
    (role_id, permission_code) [unique]
  }
}

Table center {
  center_id int [pk, increment]
  center_name nvarchar [not null]
  address nvarchar
  phone nvarchar
  email nvarchar
  area_m2 decimal
  description nvarchar
}

Table room {
  room_id int [pk, increment]
  center_id int [not null, ref: > center.center_id]
  room_code nvarchar [not null, unique]
  room_name nvarchar [not null]
  room_type nvarchar
  capacity int
  area_m2 decimal
  description nvarchar
  image_path nvarchar
}

Table "user" {
  user_id int [pk, increment]
  role_id int [not null, ref: > role.role_id]
  center_id int [ref: > center.center_id]
  full_name nvarchar [not null]
  email nvarchar [unique]
  phone nvarchar
  password_hash nvarchar
  date_of_birth date
  gender nvarchar
  avatar_url nvarchar
  status nvarchar [not null]
  created_at datetime [not null]
}

Table sport {
  sport_id int [pk, increment]
  sport_code nvarchar [not null, unique]
  sport_name nvarchar [not null]
  category nvarchar
}

Table course {
  course_id int [pk, increment]
  sport_id int [not null, ref: > sport.sport_id]
  course_code nvarchar [not null, unique]
  course_name nvarchar [not null]
  level_name nvarchar
  age_range nvarchar
  description nvarchar
  price decimal [not null]
  image_path nvarchar
  status nvarchar [not null]
}

Table material {
  material_id int [pk, increment]
  course_id int [not null, ref: > course.course_id]
  title nvarchar [not null]
  material_type nvarchar
  file_url nvarchar
  description nvarchar
}

Table training_plan {
  training_plan_id int [pk, increment]
  created_by_user_id int [not null, ref: > "user".user_id]
  plan_name nvarchar [not null]
  description nvarchar
  duration_weeks int
  created_at datetime [not null]
}

Table class {
  class_id int [pk, increment]
  course_id int [not null, ref: > course.course_id]
  training_plan_id int [not null, ref: > training_plan.training_plan_id]
  coach_user_id int [not null, ref: > "user".user_id]
  room_id int [ref: > room.room_id]
  class_name nvarchar [not null]
  start_date date
  end_date date
  capacity int
  status nvarchar [not null]
}

Table class_enrollment {
  class_enrollment_id int [pk, increment]
  class_id int [not null, ref: > class.class_id]
  user_id int [not null, ref: > "user".user_id]
  enrolled_at datetime [not null]
  status nvarchar [not null]

  Indexes {
    (class_id, user_id) [unique]
  }
}

Table slot {
  slot_id int [pk, increment]
  class_id int [not null, ref: > class.class_id]
  room_id int [ref: > room.room_id]
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  title nvarchar
}

Table assignment {
  assignment_id int [pk, increment]
  slot_id int [not null, ref: > slot.slot_id]
  title nvarchar [not null]
  description nvarchar
  due_at datetime
}

Table attendance {
  attendance_id int [pk, increment]
  slot_id int [not null, ref: > slot.slot_id]
  user_id int [not null, ref: > "user".user_id]
  check_in_at datetime
  status nvarchar [not null]

  Indexes {
    (slot_id, user_id) [unique]
  }
}

Table evaluation {
  evaluation_id int [pk, increment]
  class_id int [not null, ref: > class.class_id]
  assignment_id int [ref: > assignment.assignment_id]
  evaluator_user_id int [not null, ref: > "user".user_id]
  evaluated_user_id int [not null, ref: > "user".user_id]
  reviewer_user_id int [ref: > "user".user_id]
  score decimal
  comment nvarchar
  evaluated_at datetime [not null]
}

Table invoice {
  invoice_id int [pk, increment]
  user_id int [not null, ref: > "user".user_id]
  invoice_code nvarchar [not null, unique]
  issued_at datetime [not null]
  total_amount decimal [not null]
  status nvarchar [not null]
}

Table payment {
  payment_id int [pk, increment]
  invoice_id int [not null, ref: > invoice.invoice_id]
  user_id int [not null, ref: > "user".user_id]
  class_id int [ref: > class.class_id]
  amount decimal [not null]
  payment_method nvarchar [not null]
  paid_at datetime
  status nvarchar [not null]
}

Table membership {
  membership_id int [pk, increment]
  user_id int [not null, ref: > "user".user_id]
  payment_id int [unique, ref: - payment.payment_id]
  plan_name nvarchar [not null]
  start_date date [not null]
  end_date date [not null]
  status nvarchar [not null]
}

Table audit_log {
  audit_log_id int [pk, increment]
  user_id int [ref: > "user".user_id]
  action nvarchar [not null]
  entity_name nvarchar [not null]
  entity_id int
  detail nvarchar
  created_at datetime [not null]
}

Table consultation_request {
  consultation_request_id int [pk, increment]
  received_by_user_id int [ref: > "user".user_id]
  full_name nvarchar [not null]
  phone nvarchar [not null]
  email nvarchar
  age int
  interested_sports nvarchar
  status nvarchar [not null]
  created_at datetime [not null]
}

Table notification {
  notification_id int [pk, increment]
  user_id int [not null, ref: > "user".user_id]
  title nvarchar [not null]
  content nvarchar [not null]
  is_read bit [not null]
  created_at datetime [not null]
}
